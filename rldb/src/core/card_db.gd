class_name CardDB
extends RefCounted
## Static card definitions loaded from data/cards.json (generated by tools/import_cards.py).
## Definitions are shared and never mutated; per-game state lives on card instances.

const CARDS_PATH := "res://data/cards.json"

const BUFFS := ["retain", "eternal", "pierce", "cleanse", "medic", "infiltrate", "nimble"]
const DEBUFFS := ["reveal", "burn", "paralyse", "curse", "poison", "blind", "debilitate"]
const STATUS_ORDER := ["retain", "eternal", "pierce", "cleanse", "medic", "infiltrate", "nimble",
	"reveal", "burn", "paralyse", "curse", "poison", "blind", "debilitate"]

const TYPE_ADVANTAGE := {
	"Water": "Fire", "Fire": "Earth", "Earth": "Lightning", "Lightning": "Water",
	"Light": "Dark", "Dark": "Physical", "Physical": "Light",
}
const ELEMENTS := ["Water", "Fire", "Earth", "Lightning", "Light", "Dark", "Physical"]
const RACES := ["Mage", "Dragon", "Warrior", "Beast", "Monster", "God"]

const STATUS_HELP := {
	"rune": "Rune: a unit with enough Runes can be tributed for a Ritual summon. Unaffected by Curse.",
	"retain": "Retain: not discarded at end of turn. One stack is consumed each time it prevents a discard.",
	"reveal": "Reveal: this card is face up. No duration.",
	"eternal": "Eternal: prevents the next destruction of this unit (one stack consumed). Battle HP damage still applies.",
	"burn": "Burn: when this unit attacks, its controller takes Damage equal to Burn, then all Burn is removed.",
	"pierce": "Pierce: attacking a Defense-stance unit, excess ATK damages the opponent. One stack consumed.",
	"cleanse": "Cleanse: removes all existing debuffs or prevents an incoming debuff. One stack consumed per use.",
	"paralyse": "Paralyse: cannot declare an attack, move zones or change stance (a stance change forced by a card still happens). -1 at the end of its controller's turn.",
	"medic": "Medic: at the start of its controller's turn they Heal HP equal to Medic, then -1.",
	"curse": "Curse: removes all buffs or prevents an incoming buff (not Runes). One stack consumed per use.",
	"poison": "Poison: at the end of its controller's turn they take Damage equal to Poison, then -1.",
	"infiltrate": "Infiltrate: may attack protected units. One stack consumed when it does.",
	"blind": "Blind: attack target is chosen at random among legal targets. One stack consumed when it attacks.",
	"nimble": "Nimble: once per turn move to an adjacent empty zone (diagonals count). One stack consumed per move.",
	"debilitate": "Debilitate: cannot be sacrificed or tributed; all its effects are suppressed. -1 at the end of its controller's turn.",
}

static var _defs: Dictionary = {}
static var _notes: Array = []


## Loads definitions once. Safe to call repeatedly.
static func ensure_loaded() -> void:
	if not _defs.is_empty():
		return
	var text := FileAccess.get_file_as_string(CARDS_PATH)
	var data: Dictionary = JSON.parse_string(text)
	for c in data["cards"]:
		c["id"] = int(c["id"])
		if c["cost"] != null:
			c["cost"] = int(c["cost"])
		if c["atk"] != null:
			c["atk"] = int(c["atk"])
		if c["def"] != null:
			c["def"] = int(c["def"])
		_defs[c["id"]] = c
	_notes = data["unassigned_source_notes"]


## Returns the shared definition for a card id.
static func get_def(id: int) -> Dictionary:
	ensure_loaded()
	return _defs[id]


static func has(id: int) -> bool:
	ensure_loaded()
	return _defs.has(id)


## All definitions in source order (the 2026-10-18 export repeats some indices; ties go by id).
## A card with no sheet index (the 3 Nov 2026 new cards: null) sorts after every indexed card.
static func all() -> Array:
	ensure_loaded()
	var out := _defs.values()
	out.sort_custom(func(a, b): return _order_before(a, b))
	return out


## Source-order comparison of two definitions: by sheet index (none = last), then by id.
static func _order_before(a: Dictionary, b: Dictionary) -> bool:
	var ia = a["source"].get("index")
	var ib = b["source"].get("index")
	var na := ia == null
	var nb := ib == null
	if na != nb:
		return nb                         # an indexed card comes before one without an index
	if not na and float(ia) != float(ib):
		return float(ia) < float(ib)
	return int(a["id"]) < int(b["id"])


static func unassigned_notes() -> Array:
	ensure_loaded()
	return _notes


static func is_unit_category(cat: String) -> bool:
	return cat in ["basic_unit", "unit", "fusion", "ritual", "arcane"]


static func is_extra_category(cat: String) -> bool:
	return cat in ["fusion", "ritual", "arcane"]


static func is_buff(status: String) -> bool:
	return status in BUFFS


static func is_debuff(status: String) -> bool:
	return status in DEBUFFS


## Human-readable cost string that keeps the cost kinds distinct.
static func cost_label(d: Dictionary, current = null) -> String:
	match d["cost_kind"]:
		"fusion":
			return "Fusion"
		"ritual":
			var r = current if current != null else d["cost"]
			return ("?" if r == null else str(r)) + " Rune"
		"arcane":
			return str(current if current != null else d["cost"]) + " Arcane"
	return str(current if current != null else d["cost"]) + " AP"
