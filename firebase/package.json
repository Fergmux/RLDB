{
  "name": "rldb-firebase-tools",
  "private": true,
  "description": "RLDB telemetry: Firestore rules emulator tests and the owner-run admin tool (Spark plan, no Cloud Functions).",
  "type": "commonjs",
  "scripts": {
    "test:unit": "node --test tools/test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore,auth --project rldb-b5593 \"node --test tests/rules.test.js\"",
    "admin": "node tools/rldb-admin.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0"
  }
}
